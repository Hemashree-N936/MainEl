APP_NAME="Predictive Cloud Security Intelligence Platform"
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/sqlite/platform.db
REPOSITORY_STORAGE_PATH=./data/repositories
MODEL_ARTIFACT_PATH=./artifacts/models
ACTIVE_MODEL_NAME=repository_risk_model
MINIMUM_TRAINING_ROWS=50
API_BASE_URL=http://localhost:8000/api/v1
DASHBOARD_REQUEST_TIMEOUT_SECONDS=8
DASHBOARD_DEMO_MODE=true
DASHBOARD_LOG_LEVEL=INFO
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_TIMEOUT_SECONDS=20
NVD_MAX_RETRIES=3
NVD_RETRY_BACKOFF_SECONDS=1.5
NVD_RESULTS_PER_PAGE=2000
NVD_CACHE_TTL_SECONDS=3600
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TOKEN=
GITHUB_TIMEOUT_SECONDS=15
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_BACKOFF_SECONDS=1.2
